# Optional custom OpenAI-compatible or Anthropic-compatible service.
# Keep the real key in .env, not in source control.
FACTOR_API_STYLE=openai
FACTOR_API_BASE=http://your-server:8000/v1
FACTOR_MODEL=your-model
FACTOR_API_KEY=

# Native NOOA orchestration sandbox (Linux).
# auto: use Landlock if available; required: refuse without it; off: no file confinement.
FACTOR_SANDBOX_FILESYSTEM=auto
# 1 allows direct REST requests in both the outer native sandbox and scientific workers.
FACTOR_CELL_ALLOW_NETWORK=0
# Optional existing read-write directory for native outer cells; leave empty for none.
FACTOR_SANDBOX_WORKSPACE=
FACTOR_SANDBOX_MEMORY_MB=2048
FACTOR_SANDBOX_CPU_SECONDS=300
