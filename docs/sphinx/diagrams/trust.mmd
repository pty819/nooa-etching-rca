flowchart TB
  subgraph HOST["可信编排进程"]
    KEY["本地模型凭据"] --> API["模型客户端 · 共享预算"]
    NOOA["NOOA CodeActV2<br/>历史 · 策略 · 摘要"] --> API
    NOOA --> RPC["声明工具代理<br/>JSON类型与调用序号校验"]
    LEDGER["私有执行账本<br/>输入 · 代码 · 产物哈希"] --> VERIFY["原始值与模型指标独立重算"]
    TEST["私有test · 仿真参考"] --> EVAL["冻结后收尾评分"]
    VERIFY --> MD["规范Markdown直接推送"]
  end
  subgraph OUTER["外层生成代码：无凭据新进程"]
    CELL["CodeAct cell<br/>仅声明工具与参数"]
  end
  NOOA --> CELL
  CELL --> RPC
  subgraph SCIENCE["科学代码：逐cell新进程"]
    PY["自由Python · 已安装科学库"]
    IN["当前DATASET只读版本"] --> PY
    PY --> WORK["仅本方向工作区可写"]
  end
  RPC --> PY
  PY -->|"stdout仅文本 · 实际退出码"| LEDGER
  RULES["macOS deny-default<br/>Linux Landlock / bubblewrap + seccomp<br/>检查点只在子进程加载"] -.-> OUTER
